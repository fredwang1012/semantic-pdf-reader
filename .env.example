# Copy to .env at the repo root. Every setting is optional.

# auto: use multilingual-e5 embeddings when the "embed" extra is installed, else BM25 only. off: always BM25 only.
EMBED=auto
# Where uploaded PDFs and their indexes are stored (one folder per PDF). A relative path is resolved against the repo root (not the working directory). Defaults to ./data.
DATA_DIR=./data
# Largest PDF the upload endpoint accepts, in megabytes.
MAX_UPLOAD_MB=100
# Comma-separated browser origins allowed by CORS. The built frontend is served same-origin and needs none.
CORS_ORIGINS=http://localhost:5173
